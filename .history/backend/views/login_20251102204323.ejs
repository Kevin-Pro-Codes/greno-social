<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
 <div class="container">
  <div class="logo-container">
    <img src="/assets/greeno.jpg" alt="Greeno Logo" class="logo-image" width="120" height="80">
    <h2 class="font-greeno">Greeno Social</h2>
  </div>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form class="login" method="POST" action="/login">
    <input name="loginId" placeholder="Login" required />
    <input name="password" type="password" placeholder="Password" required /><br />
    <button type="submit" style="text-decoration: none; color: black;">Login</button>
  </form>

  <p class="font-white">Don't have account? <a href="/register" style="text-decoration: none; color: #007bff;">Register</a></p>
</div>
</body>
</html>
